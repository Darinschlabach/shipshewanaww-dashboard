NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# QuickBooks Online OAuth (server-only — never NEXT_PUBLIC_)
INTUIT_CLIENT_ID=your-intuit-client-id
INTUIT_CLIENT_SECRET=your-intuit-client-secret
# Optional override; default is {NEXT_PUBLIC_SITE_URL}/api/integrations/quickbooks/callback
# INTUIT_REDIRECT_URI=http://localhost:3000/api/integrations/quickbooks/callback
# INTUIT_SCOPES=com.intuit.quickbooks.accounting
# sandbox (default) or production
INTUIT_ENVIRONMENT=sandbox
# Optional: expose sandbox/production to the browser for “View in QuickBooks” links
# NEXT_PUBLIC_INTUIT_ENVIRONMENT=sandbox
# Optional QuickBooks Service item Id; if empty, resolves/creates “Services”
INTUIT_SERVICE_ITEM_ID=

# Microsoft Graph (server-only — never NEXT_PUBLIC_)
# App registration: OAuth 2.0 client credentials for OneDrive/SharePoint
MICROSOFT_TENANT_ID=your-microsoft-tenant-id
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Set after using Settings → Integrations → Microsoft Graph discovery
MICROSOFT_DRIVE_ID=your-microsoft-drive-id
MICROSOFT_JOBS_FOLDER_ID=your-microsoft-jobs-folder-id
MICROSOFT_QUOTES_FOLDER_ID=your-microsoft-quotes-folder-id
